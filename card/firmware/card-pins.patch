+// The ZX81 can be switched off while the card stays on USB power. RESET is driven high
+// after boot, so the ZX81's own power-on reset can't work when it comes back, and its Z80
+// would start without a reset. The buffered Z80 clock stops while the ZX81 is off, so
+// watch for that: hold RESET low until the clock returns, then restart the card. RESET
+// isn't read for this, because 1.5 s and 5 s of RESET low are button commands.
+static bool zx_clock_running(void)
+{
+    bool seenLow = false, seenHigh = false;
+    uint32_t start = time_us_32();
+    while ((time_us_32() - start) < 4)
+    {   // a 3.25 MHz clock shows both levels many times in 4 us
+        if (gpio_get(Z80_CLK)) seenHigh = true; else seenLow = true;
+        if (seenLow && seenHigh) return true;
+    }
+    return false;
+}
+
+void reset_watch_zx_power(void)
+{
+    if (zx_clock_running())
+    {
+        return;
+    }
+    for (int i = 0; i < 20; i++)
+    {   // 20 ms without a clock before calling it a power cut
+        delay(1);
+        if (zx_clock_running())
+        {
+            return;
+        }
+    }
+    gpio_put(Z80_RST, 0);
+    Serial.println("ZX81 power off: holding RESET low");
+    do
+    {
+        rp2040.wdt_reset();
+        delay(10);
+    }
+    while (!zx_clock_running());
+    // Resetting the Z80 alone isn't enough: on a TS1000 that left a blank or garbled
+    // screen, as the card's video and bus state don't survive seconds without a clock.
+    // Restart the whole card instead, as the RUN button does.
+    Serial.println("ZX81 power on: restarting the card");
+    Serial.flush();
+    delay(100); // let the ZX81's supply settle
+    rp2040.reboot();
+}
