@@ -60,7 +60,9 @@
 
 __force_inline  uint16_t z80_addr_get()
 {
-    return gpio_get_all_hi();
+    // A0..A3 on GPIO8..11; A4..A15 reversed on GPIO31..20, so RBIT puts them in bits 0..11
+    uint32_t lo = gpio_get_all_lo();
+    return ((lo >> Z80_ADDR_LO_SHIFT) & 0x000F) | ((__rbit(lo) << 4) & 0xFFF0);
 };
 
