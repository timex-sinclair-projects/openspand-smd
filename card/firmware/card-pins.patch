diff -ruN a/dvi_impl.h b/dvi_impl.h
--- a/dvi_impl.h
+++ b/dvi_impl.h
@@ -0,0 +1,330 @@
+/*
+DVI out over HSTX for the OpenSpand Card v0.2, in place of upstream's composite video.
+
+Core 1 captures each pixel byte it hands to the ULA, with the T-state since INTACK and
+the line since VSYNC, into a ring buffer (dvi_capture()). Core 0 draws those into a
+320 x 240, 1 bit per pixel frame buffer, three of them so a finished frame is never
+shown half drawn. ZX81 frames come at about 59.4 Hz here, DVI at 60, so now and then
+a frame is shown twice.
+
+The output is 640 x 480 at 60 Hz. HSTX's own 1 bit mode can't show full white (a 1-bit
+lane is the top bit of 8), so core 0 expands each frame line into an 8 bpp RGB332 line
+buffer just before it is needed, doubling it both ways. A DMA interrupt per output line
+does that, and drains the ring buffer in the same pass.
+
+HSTX needs 126 MHz (25.2 MHz pixels, 5 HSTX clocks each), which 208 MHz can't give, so
+PLL_USB is retuned for it. That stops USB: build with "USB Stack: No USB".
+
+This file is part of OpenSpand (GPL-3.0-or-later).
+*/
+#ifndef _DVI_IMPL_H_
+#define _DVI_IMPL_H_
+
+#include "hardware/clocks.h"
+#include "hardware/dma.h"
+#include "hardware/irq.h"
+#include "hardware/pll.h"
+#include "hardware/resets.h"
+#include "hardware/structs/bus_ctrl.h"
+#include "hardware/structs/hstx_ctrl.h"
+#include "hardware/structs/hstx_fifo.h"
+#include "pins.h"
+#include "globals.h"
+
+// Where the 320 x 240 window sits in the ZX81 picture. Upstream's composite video
+// shows 160 T-states of each line from T-state 47 after INTACK: two pixels each.
+#define DVI_FIRST_TSTATE    47
+#define DVI_FIRST_LINE      32   // lines after VSYNC ends
+
+// ---------------------------------------------------------------- capture (core 1)
+
+#define DVI_RING_SIZE       4096 // power of 2
+#define DVI_FRAME_MARK      0x80000000u
+
+volatile uint32_t dviRing[DVI_RING_SIZE];
+volatile uint32_t dviRingHead; // only core 1 writes this
+
+// Core 1, right after the byte is on the bus: a handful of instructions.
+static __force_inline void dvi_capture(uint8_t pixels)
+{
+    uint32_t t = tstate_counter_get();
+    uint32_t y = line_counter_get_full();
+    uint32_t h = dviRingHead;
+    dviRing[h & (DVI_RING_SIZE - 1)] = pixels | (t & 0x1FF) << 8 | (y & 0x1FF) << 17;
+    dviRingHead = h + 1;
+}
+
+// Core 1, at the end of VSYNC: the frame just captured is complete.
+static __force_inline void dvi_capture_frame_end(void)
+{
+    uint32_t h = dviRingHead;
+    dviRing[h & (DVI_RING_SIZE - 1)] = DVI_FRAME_MARK;
+    dviRingHead = h + 1;
+}
+
+// ---------------------------------------------------------------- frame buffers (core 0)
+
+enum {
+    DVI_FB_W = 320, DVI_FB_H = 240, DVI_FB_STRIDE = DVI_FB_W / 8,
+    DVI_FB_COUNT = 3, DVI_LINE_BUFS = 4,
+};
+static uint8_t dviFb[DVI_FB_COUNT][DVI_FB_H][DVI_FB_STRIDE];
+static uint8_t dviShow = 0, dviDraw = 1, dviReady = 0xFF; // 0xFF: no new frame yet
+static uint32_t dviRingTail;
+
+static void dvi_fb_clear(uint8_t fb)
+{
+    memset(dviFb[fb], borderInverter, sizeof dviFb[fb]);
+}
+
+// Bit 7 of a byte is its leftmost pixel, as in the ZX81; 1 is white.
+static __force_inline void dvi_fb_put(uint32_t v)
+{
+    int y = (int)(v >> 17 & 0x1FF) - DVI_FIRST_LINE;
+    int x = 2 * ((int)(v >> 8 & 0x1FF) - DVI_FIRST_TSTATE);
+    if (y < 0 || y >= DVI_FB_H || x <= -8 || x >= DVI_FB_W)
+        return;
+    uint8_t *row = dviFb[dviDraw][y];
+    int at = x >> 3, shift = x & 7;
+    uint32_t bits = (v & 0xFF) << (8 - shift), mask = 0xFFu << (8 - shift);
+    if (at >= 0)
+        row[at] = (uint8_t)((row[at] & ~(mask >> 8)) | bits >> 8);
+    if (shift && at + 1 < DVI_FB_STRIDE)
+        row[at + 1] = (uint8_t)((row[at + 1] & ~mask) | (bits & 0xFF));
+}
+
+static void __not_in_flash_func(dvi_drain)(unsigned budget)
+{
+    uint32_t head = dviRingHead;
+    __dmb();
+    while (dviRingTail != head && budget--) {
+        uint32_t v = dviRing[dviRingTail & (DVI_RING_SIZE - 1)];
+        dviRingTail++;
+        if (v & DVI_FRAME_MARK) {
+            dviReady = dviDraw;
+            for (uint8_t i = 0; i < DVI_FB_COUNT; i++)
+                if (i != dviShow && i != dviReady)
+                    dviDraw = i;
+            dvi_fb_clear(dviDraw);
+        } else {
+            dvi_fb_put(v);
+        }
+    }
+}
+
+// ---------------------------------------------------------------- 640 x 480 output
+
+enum {
+    H_ACTIVE = 640, H_FRONT = 16, H_SYNC = 96, H_BACK = 48,
+    V_ACTIVE = 480, V_FRONT = 10, V_SYNC = 2, V_BACK = 33,
+    V_TOTAL = V_ACTIVE + V_FRONT + V_SYNC + V_BACK,
+    // one block per blank line, two per picture line, one to restart the list
+    DVI_BLOCKS = (V_TOTAL - V_ACTIVE) + 2 * V_ACTIVE + 1,
+};
+
+#define CMD_RAW_REPEAT (0x1u << 12)
+#define CMD_TMDS       (0x2u << 12)
+#define CMD_NOP        (0xfu << 12)
+#define CTRL_00 0x354u
+#define CTRL_01 0x0abu
+#define CTRL_10 0x154u
+#define CTRL_11 0x2abu
+#define SYNC_WORD(lane0) ((lane0) | CTRL_00 << 10 | CTRL_00 << 20)
+#define V0_H0 SYNC_WORD(CTRL_00)
+#define V0_H1 SYNC_WORD(CTRL_01)
+#define V1_H0 SYNC_WORD(CTRL_10)
+#define V1_H1 SYNC_WORD(CTRL_11)
+
+// Read by DMA every line, so in RAM.
+static uint32_t dviLineBlank[] = {
+    CMD_RAW_REPEAT | H_FRONT, V1_H1,
+    CMD_RAW_REPEAT | H_SYNC, V1_H0,
+    CMD_RAW_REPEAT | (H_BACK + H_ACTIVE), V1_H1,
+    CMD_NOP,
+};
+static uint32_t dviLineVsync[] = {
+    CMD_RAW_REPEAT | H_FRONT, V0_H1,
+    CMD_RAW_REPEAT | H_SYNC, V0_H0,
+    CMD_RAW_REPEAT | (H_BACK + H_ACTIVE), V0_H1,
+    CMD_NOP,
+};
+static uint32_t dviLineActive[] = {
+    CMD_RAW_REPEAT | H_FRONT, V1_H1,
+    CMD_NOP,
+    CMD_RAW_REPEAT | H_SYNC, V1_H0,
+    CMD_NOP,
+    CMD_RAW_REPEAT | H_BACK, V1_H1,
+    CMD_TMDS | H_ACTIVE,
+};
+
+// A DMA channel's alias 3 registers; writing read_addr starts the transfer.
+typedef struct {
+    uint32_t ctrl, write_addr, count, read_addr;
+} dvi_block_t;
+
+static dvi_block_t dviBlocks[DVI_BLOCKS];
+static const dvi_block_t *dviListStart = dviBlocks;
+static uint32_t dviLineBuf[DVI_LINE_BUFS][H_ACTIVE / 4];
+static uint32_t dviExpand[256][4]; // one frame byte -> 16 doubled RGB332 pixels
+static uint dviControl, dviData;
+
+static void __not_in_flash_func(dvi_render)(unsigned fbY)
+{
+    uint32_t *out = dviLineBuf[fbY % DVI_LINE_BUFS];
+    const uint8_t *in = dviFb[dviShow][fbY];
+    for (unsigned i = 0; i < DVI_FB_STRIDE; i++, out += 4) {
+        const uint32_t *e = dviExpand[in[i]];
+        out[0] = e[0]; out[1] = e[1]; out[2] = e[2]; out[3] = e[3];
+    }
+}
+
+static void dvi_new_frame(void)
+{
+    if (dviReady != 0xFF) {
+        dviShow = dviReady;
+        dviReady = 0xFF;
+    }
+    dvi_render(0);
+    dvi_render(1);
+}
+
+// Raised by the picture-row blocks only, as each finishes loading the FIFO. The row
+// block of output line L is block blank + 2L + 1; by the time this runs the control
+// channel has loaded the next block, maybe one more, so it points at blank + 2L + 3
+// or + 4. After the last line it may already have wrapped to the top of the list.
+static void __not_in_flash_func(dvi_line_irq)(void)
+{
+    if (!(dma_hw->ints1 & (1u << dviData)))
+        return;
+    dma_hw->ints1 = 1u << dviData;
+    const unsigned blank = V_TOTAL - V_ACTIVE;
+    unsigned next = ((uint32_t)dma_hw->ch[dviControl].read_addr - (uint32_t)dviBlocks) /
+                    sizeof(dvi_block_t);
+    unsigned line = next >= blank + 3 ? (next - blank - 3) / 2 : V_ACTIVE - 1;
+    if (line >= V_ACTIVE - 1) {
+        dvi_drain(DVI_RING_SIZE); // catch up: the vertical blank follows
+        dvi_new_frame();
+        return;
+    }
+    if (line & 1) {
+        unsigned fbY = (line + 1) / 2 + 1; // two frame lines ahead of the output
+        if (fbY < DVI_FB_H)
+            dvi_render(fbY);
+    }
+    dvi_drain(64);
+}
+
+// Call right after set_sys_clock_khz(208 MHz), before any peripheral is set up.
+void dvi_clocks_init(void)
+{
+    uint32_t sys = clock_get_hz(clk_sys);
+    clock_configure(clk_peri, 0, CLOCKS_CLK_PERI_CTRL_AUXSRC_VALUE_CLK_SYS, sys, sys);
+    clock_stop(clk_usb);
+    clock_stop(clk_adc);
+    clock_stop(clk_hstx);
+    pll_init(pll_usb, 1, 1008 * MHZ, 4, 2); // 126 MHz
+    clock_configure(clk_hstx, 0, CLOCKS_CLK_HSTX_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB,
+                    126 * MHZ, 126 * MHZ);
+}
+
+static void dvi_hstx_init(void)
+{
+    reset_block_num(RESET_HSTX);
+    unreset_block_num_wait_blocking(RESET_HSTX);
+    // RGB332: blue on lane 0, green on 1, red on 2
+    hstx_ctrl_hw->expand_tmds =
+        2u << HSTX_CTRL_EXPAND_TMDS_L2_NBITS_LSB | 0u << HSTX_CTRL_EXPAND_TMDS_L2_ROT_LSB |
+        2u << HSTX_CTRL_EXPAND_TMDS_L1_NBITS_LSB | 29u << HSTX_CTRL_EXPAND_TMDS_L1_ROT_LSB |
+        1u << HSTX_CTRL_EXPAND_TMDS_L0_NBITS_LSB | 26u << HSTX_CTRL_EXPAND_TMDS_L0_ROT_LSB;
+    hstx_ctrl_hw->expand_shift =
+        4u << HSTX_CTRL_EXPAND_SHIFT_ENC_N_SHIFTS_LSB |
+        8u << HSTX_CTRL_EXPAND_SHIFT_ENC_SHIFT_LSB |
+        1u << HSTX_CTRL_EXPAND_SHIFT_RAW_N_SHIFTS_LSB |
+        0u << HSTX_CTRL_EXPAND_SHIFT_RAW_SHIFT_LSB;
+    hstx_ctrl_hw->csr = 0;
+    hstx_ctrl_hw->csr = HSTX_CTRL_CSR_EXPAND_EN_BITS | 5u << HSTX_CTRL_CSR_CLKDIV_LSB |
+                        5u << HSTX_CTRL_CSR_N_SHIFTS_LSB | 2u << HSTX_CTRL_CSR_SHIFT_LSB |
+                        HSTX_CTRL_CSR_EN_BITS;
+    // As routed on the card: CK, D0, D1, D2 from HSTX bit 0, negative on even bits.
+    for (unsigned bit = 0; bit < 8; bit++) {
+        int lane = (int)(bit / 2) - 1;
+        uint32_t config = lane < 0 ? HSTX_CTRL_BIT0_CLK_BITS
+                                   : (uint32_t)(lane * 10) << HSTX_CTRL_BIT0_SEL_P_LSB |
+                                     (uint32_t)(lane * 10 + 1) << HSTX_CTRL_BIT0_SEL_N_LSB;
+        if (!(bit & 1))
+            config |= HSTX_CTRL_BIT0_INV_BITS;
+        hstx_ctrl_hw->bit[bit] = config;
+    }
+}
+
+static void dvi_dma_init(void)
+{
+    dviControl = dma_claim_unused_channel(true);
+    dviData = dma_claim_unused_channel(true);
+
+    dma_channel_config d = dma_channel_get_default_config(dviData);
+    channel_config_set_dreq(&d, DREQ_HSTX);
+    channel_config_set_chain_to(&d, dviControl);
+    channel_config_set_high_priority(&d, true);
+    channel_config_set_irq_quiet(&d, true);
+    dma_channel_config rows = d;
+    channel_config_set_irq_quiet(&rows, false);
+    dma_channel_config restart = dma_channel_get_default_config(dviData); // no chain
+    channel_config_set_read_increment(&restart, false);
+    channel_config_set_high_priority(&restart, true);
+    channel_config_set_irq_quiet(&restart, true);
+
+    uint32_t dataCtrl = channel_config_get_ctrl_value(&d);
+    uint32_t rowCtrl = channel_config_get_ctrl_value(&rows);
+    uint32_t fifo = (uint32_t)&hstx_fifo_hw->fifo;
+    unsigned n = 0;
+    for (unsigned line = 0; line < V_TOTAL; line++) {
+        bool active = line >= V_TOTAL - V_ACTIVE;
+        bool sync = line >= V_FRONT && line < V_FRONT + V_SYNC;
+        if (active) {
+            unsigned y = line - (V_TOTAL - V_ACTIVE);
+            dviBlocks[n++] = (dvi_block_t){dataCtrl, fifo, count_of(dviLineActive),
+                                           (uint32_t)dviLineActive};
+            dviBlocks[n++] = (dvi_block_t){rowCtrl, fifo, H_ACTIVE / 4,
+                                           (uint32_t)dviLineBuf[(y / 2) % DVI_LINE_BUFS]};
+        } else {
+            uint32_t *list = sync ? dviLineVsync : dviLineBlank;
+            dviBlocks[n++] = (dvi_block_t){dataCtrl, fifo, count_of(dviLineBlank),
+                                           (uint32_t)list};
+        }
+    }
+    dviBlocks[n++] = (dvi_block_t){channel_config_get_ctrl_value(&restart),
+                                   (uint32_t)&dma_hw->ch[dviControl].al3_read_addr_trig, 1,
+                                   (uint32_t)&dviListStart};
+
+    dma_channel_set_irq1_enabled(dviData, true);
+    irq_add_shared_handler(DMA_IRQ_1, dvi_line_irq, PICO_SHARED_IRQ_HANDLER_HIGHEST_ORDER_PRIORITY);
+    irq_set_priority(DMA_IRQ_1, 0);
+    irq_set_enabled(DMA_IRQ_1, true);
+
+    dma_channel_config c = dma_channel_get_default_config(dviControl);
+    channel_config_set_write_increment(&c, true);
+    channel_config_set_ring(&c, true, 4); // the four alias 3 registers
+    channel_config_set_high_priority(&c, true);
+    bus_ctrl_hw->priority = BUSCTRL_BUS_PRIORITY_DMA_R_BITS | BUSCTRL_BUS_PRIORITY_DMA_W_BITS;
+    dma_channel_configure(dviControl, &c, &dma_hw->ch[dviData].al3_ctrl, dviBlocks, 4, true);
+}
+
+// After dvi_clocks_init() and pio_video_code_init() (for borderInverter).
+void dvi_init(void)
+{
