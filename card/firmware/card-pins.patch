diff -ruN a/dvi_impl.h b/dvi_impl.h
--- a/dvi_impl.h
+++ b/dvi_impl.h
@@ -0,0 +1,509 @@
+/*
+DVI out over HSTX for the OpenSpand Card v0.2, in place of upstream's composite video.
+
+Core 1 captures each pixel byte it hands to the ULA, with the T-state since INTACK and
+the line since VSYNC, into a ring buffer (dvi_capture()). Core 0 draws those into a
+320 x 240, 1 bit per pixel frame buffer, three of them so a finished frame is never
+shown half drawn. ZX81 frames come at about 59.4 Hz here, DVI at 60, so now and then
+a frame is shown twice.
+
+The output is 640 x 480 at 60 Hz. HSTX's own 1 bit mode can't show full white (a 1-bit
+lane is the top bit of 8), so core 0 expands each frame line into an 8 bpp RGB332 line
+buffer just before it is needed, doubling it both ways. A DMA interrupt per output line
+does that, and drains the ring buffer in the same pass.
+
+HSTX needs 126 MHz (25.2 MHz pixels, 5 HSTX clocks each), which 208 MHz can't give, so
+PLL_USB is retuned for it. That stops USB: build with "USB Stack: No USB".
+
+Sound goes out as HDMI: each line's blanking carries one data island in its hsync pulse,
+with InfoFrames, audio clock regeneration or audio samples from audio_impl.h's 48 kHz
+ring. A line's blanking is a command list in one of 15 slots, filled by the line
+interrupt 7 or 8 lines ahead.
+
+This file is part of OpenSpand (GPL-3.0-or-later).
+*/
+#ifndef _DVI_IMPL_H_
+#define _DVI_IMPL_H_
+
+#include "hardware/clocks.h"
+#include "hardware/dma.h"
+#include "hardware/irq.h"
+#include "hardware/pll.h"
+#include "hardware/resets.h"
+#include "hardware/structs/bus_ctrl.h"
+#include "hardware/structs/hstx_ctrl.h"
+#include "hardware/structs/hstx_fifo.h"
+#include "pins.h"
+#include "globals.h"
+#include "audio.h"
+#include "hdmi_packet.h"
+
+// Where the 320 x 240 window sits in the ZX81 picture, two pixels per T-state. On the
+// TS1000s tried, the first byte of a line reads 70 to 73 T-states after INTACK; 55 centres its 256 pixels.
+// Keep it 3 mod 4: a line is placed by its first byte, snapped to 4 T-states (dvi_fb_put).
+#define DVI_FIRST_TSTATE    55
+// Vertically, the picture is placed by its first display line, which comes 56 lines
+// after VSYNC ends on a TS1000 but about 16 sooner on a TS1500. The first line with
+// pixel bytes is tracked frame by frame (see dvi_drain) and put at row DVI_TOP_ROW,
+// which centres 192 lines in 240.
+#define DVI_FIRST_LINE      56   // until a frame says otherwise
+#define DVI_TOP_ROW         24
+#define DVI_ANCHOR_FRAMES   3    // frames that must agree before the picture moves
+
+// ---------------------------------------------------------------- capture (core 1)
+
+#define DVI_RING_SIZE       4096 // power of 2
+#define DVI_FRAME_MARK      0x80000000u
+// A frame with fewer pixel bytes than this held no picture (see dvi_drain). OpenSpand
+// always gives the ZX81 at least 16K, so the display file is never collapsed and even
+// a blank screen sends 24 x 8 x 32 = 6,144 bytes.
+#define DVI_FRAME_BYTES_MIN 256
+
+volatile uint32_t dviRing[DVI_RING_SIZE];
+volatile uint32_t dviRingHead; // only core 1 writes this
+
+// Core 1, right after the byte is on the bus: a handful of instructions.
+static __force_inline void dvi_capture(uint8_t pixels)
+{
+    uint32_t t = tstate_counter_get();
+    uint32_t y = line_counter_get_full();
+    uint32_t h = dviRingHead;
+    dviRing[h & (DVI_RING_SIZE - 1)] = pixels | (t & 0x1FF) << 8 | (y & 0x1FF) << 17;
+    dviRingHead = h + 1;
+}
+
+// Core 1, at the end of VSYNC: the frame just captured is complete.
+static __force_inline void dvi_capture_frame_end(void)
+{
+    uint32_t h = dviRingHead;
+    dviRing[h & (DVI_RING_SIZE - 1)] = DVI_FRAME_MARK;
+    dviRingHead = h + 1;
+}
+
+// ---------------------------------------------------------------- frame buffers (core 0)
+
+enum {
+    DVI_FB_W = 320, DVI_FB_H = 240, DVI_FB_STRIDE = DVI_FB_W / 8,
+    DVI_FB_COUNT = 3, DVI_LINE_BUFS = 4,
+};
+static uint8_t dviFb[DVI_FB_COUNT][DVI_FB_H][DVI_FB_STRIDE];
+static uint8_t dviShow = 0, dviDraw = 1, dviReady = 0xFF; // 0xFF: no new frame yet
+static uint32_t dviRingTail;
+static unsigned dviFrameBytes; // pixel bytes since the last frame mark
+
+static void __not_in_flash_func(dvi_fb_clear)(uint8_t fb)
+{
+    memset(dviFb[fb], borderInverter, sizeof dviFb[fb]);
+}
+
+// The T-state count is read on core 1 a little after the byte goes out, and that delay
+// varies, so a byte's own count can be off by a T-state or two: enough to shift a row of
+// pixels half a character. But within a line the ZX81 sends one byte every 4 T-states.
+// So only a line's first byte is placed by its T-state, snapped to the 4 T-state grid
+// (from 1 early to 2 late); the rest follow 8 pixels apart.
+static int dviLastLine = -1, dviColumn;
+static int dviAnchor = DVI_FIRST_LINE;     // display line drawn at DVI_TOP_ROW
+static int dviFrameFirst = -1;             // first line with bytes in this frame
+static int dviAnchorNew = -1, dviAnchorVotes;
+
+// Bit 7 of a byte is its leftmost pixel, as in the ZX81; 1 is white.
+static __force_inline void dvi_fb_put(uint32_t v)
+{
+    int line = (int)(v >> 17 & 0x1FF);
+    if (line != dviLastLine) {
+        dviLastLine = line;
+        if (dviFrameFirst < 0 || line < dviFrameFirst)
+            dviFrameFirst = line;
+        dviColumn = ((int)(v >> 8 & 0x1FF) - DVI_FIRST_TSTATE + 1 + 4 * 64) / 4 - 64;
+    } else {
+        dviColumn++;
+    }
+    int y = line - dviAnchor + DVI_TOP_ROW;
+    int x = 8 * dviColumn;
+    if (y < 0 || y >= DVI_FB_H || x <= -8 || x >= DVI_FB_W)
+        return;
+    uint8_t *row = dviFb[dviDraw][y];
+    int at = x >> 3, shift = x & 7;
+    uint32_t bits = (v & 0xFF) << (8 - shift), mask = 0xFFu << (8 - shift);
+    if (at >= 0)
+        row[at] = (uint8_t)((row[at] & ~(mask >> 8)) | bits >> 8);
+    if (shift && at + 1 < DVI_FB_STRIDE)
+        row[at + 1] = (uint8_t)((row[at + 1] & ~mask) | (bits & 0xFF));
+}
+
+static void __not_in_flash_func(dvi_drain)(unsigned budget)
+{
+    uint32_t head = dviRingHead;
+    __dmb();
+    while (dviRingTail != head && budget--) {
+        uint32_t v = dviRing[dviRingTail & (DVI_RING_SIZE - 1)];
+        dviRingTail++;
+        if (v & DVI_FRAME_MARK) {
+            dviLastLine = -1;
+            // In FAST mode the ROM still scans the keyboard, and each scan starts and
+            // ends VSYNC. The "frames" between hold no picture, so they're dropped. Their
+            // length isn't a safe test: it measured 310 lines on a TS1000, not 262, and
+            // a TS1500 failed a 300 to 320 window.
+            unsigned bytes = dviFrameBytes;
+            dviFrameBytes = 0;
+            int first = dviFrameFirst;
+            dviFrameFirst = -1;
+            if (bytes < DVI_FRAME_BYTES_MIN) {
+                dvi_fb_clear(dviDraw);
+                continue;
+            }
+            if (first == dviAnchor) {
+                dviAnchorVotes = 0;
+            } else if (first == dviAnchorNew) {
+                if (++dviAnchorVotes >= DVI_ANCHOR_FRAMES) {
+                    dviAnchor = first;
+                    dviAnchorVotes = 0;
+                }
+            } else {
+                dviAnchorNew = first;
+                dviAnchorVotes = 1;
+            }
+            dviReady = dviDraw;
+            for (uint8_t i = 0; i < DVI_FB_COUNT; i++)
+                if (i != dviShow && i != dviReady)
+                    dviDraw = i;
+            dvi_fb_clear(dviDraw);
+        } else {
+            dviFrameBytes++;
+            dvi_fb_put(v);
+        }
+    }
+}
+
+// ---------------------------------------------------------------- 640 x 480 output
+
+enum {
+    H_ACTIVE = 640, H_FRONT = 16, H_SYNC = 96, H_BACK = 48,
+    V_ACTIVE = 480, V_FRONT = 10, V_SYNC = 2, V_BACK = 33,
+    V_TOTAL = V_ACTIVE + V_FRONT + V_SYNC + V_BACK,
+    // one block per blank line, two per picture line, one to restart the list
+    DVI_BLOCKS = (V_TOTAL - V_ACTIVE) + 2 * V_ACTIVE + 1,
+};
+
+#define CMD_RAW        (0x0u << 12)
+#define CMD_RAW_REPEAT (0x1u << 12)
+#define CMD_TMDS       (0x2u << 12)
+#define CMD_NOP        (0xfu << 12)
+#define CTRL_00 0x354u
+#define CTRL_01 0x0abu
+#define CTRL_10 0x154u
+#define CTRL_11 0x2abu
+#define SYNC_WORD(lane0) ((lane0) | CTRL_00 << 10 | CTRL_00 << 20)
+#define V0_H0 SYNC_WORD(CTRL_00)
+#define V0_H1 SYNC_WORD(CTRL_01)
+#define V1_H0 SYNC_WORD(CTRL_10)
+#define V1_H1 SYNC_WORD(CTRL_11)
+
+// ---------------------------------------------------------------- HDMI line slots
+
+// Line layout (800 pixels): front porch 16; the hsync pulse (96): island preamble 8,
+// island 36, sync 52; back porch 48, its last 10 the video preamble and guard band on
+// picture lines; then 640 active. No NOP padding: with nothing to send, HSTX spends a
+// clock on each NOP and the symbols slip, so every slot's DMA block has its exact length.
+enum {
+    HDMI_SLOTS = 15, // 525 is a multiple of 15, so a line always uses the same slot
+    HDMI_SLOT_WORDS = 5 + HDMI_ISLAND_WORDS + 2 + 8,
+    HDMI_AHEAD = 8,  // fill up to this many lines ahead of the one going out
+    HDMI_HV = 2,     // the sync wire levels in an island outside vsync: VSYNC high, HSYNC low
+};
+static uint32_t hdmiSlots[HDMI_SLOTS][HDMI_SLOT_WORDS];
+// The packets that never change, encoded once.
+static uint32_t hdmiIslandAvi[HDMI_ISLAND_WORDS], hdmiIslandAudioInfo[HDMI_ISLAND_WORDS],
+                hdmiIslandAcr[HDMI_ISLAND_WORDS];
+static unsigned hdmiNextLine;  // next line whose slot needs filling
+static unsigned hdmiCredit;    // samples owed, in 21sts: 48 kHz is 32/21 a line
+static unsigned hdmiIecFrame;  // IEC 60958 frame number, 0..191
+
+static __force_inline bool hdmi_line_active(unsigned line) { return line >= V_TOTAL - V_ACTIVE; }
+static __force_inline bool hdmi_line_vsync(unsigned line)
+{
+    return line >= V_FRONT && line < V_FRONT + V_SYNC;
+}
+
+static unsigned hdmi_slot_words(unsigned line)
+{
+    return hdmi_line_active(line) ? HDMI_SLOT_WORDS : HDMI_SLOT_WORDS - 6;
+}
+
+static void __not_in_flash_func(hdmi_fill)(unsigned line)
+{
+    uint32_t *s = hdmiSlots[line % HDMI_SLOTS];
+    unsigned idle = hdmi_line_vsync(line) ? 1u : 3u; // bit 0 HSYNC, bit 1 VSYNC; low = active
+    unsigned sync = idle & ~1u;
+    s[0] = CMD_RAW_REPEAT | H_FRONT;
+    s[1] = SYNC_WORD(hdmi_ctrl[idle]);
+    s[2] = CMD_RAW_REPEAT | 8;
+    s[3] = HDMI_ISLAND_PREAMBLE(sync);
+    s[4] = CMD_RAW | HDMI_ISLAND_WORDS;
+    uint32_t *island = s + 5;
+    hdmiCredit += 32;
+    const uint32_t *fixed = line == 0 ? hdmiIslandAvi
+                          : line == 1 ? hdmiIslandAudioInfo
+                          : line % 75 == 2 ? hdmiIslandAcr : NULL; // 7 a frame
+    if (fixed) {
+        for (unsigned i = 0; i < HDMI_ISLAND_WORDS; i++)
+            island[i] = fixed[i];
+    } else {
+        uint32_t tail = audioRingTail, ready = audioRingHead - tail;
+        unsigned n = hdmiCredit / 21;
+        if (n > 4)
+            n = 4;
+        if (n > ready)
+            n = ready;   // the ring ran dry: send what there is, owe the rest
+        hdmiCredit -= n * 21;
+        if (hdmiCredit > 21 * 8)
+            hdmiCredit = 21 * 8;
+        hdmi_packet_t p;
+        if (n) {
+            int16_t lr[4][2];
+            for (unsigned i = 0; i < n; i++, tail++) {
+                lr[i][0] = audioRing[tail & (AUDIO_RING_SIZE - 1)][0];
+                lr[i][1] = audioRing[tail & (AUDIO_RING_SIZE - 1)][1];
+            }
+            audioRingTail = tail;
+            hdmi_packet_audio_unsealed(&p, lr, n, hdmiIecFrame);
+            hdmiIecFrame = (hdmiIecFrame + n) % 192;
+        } else {
+            memset(&p, 0, sizeof p); // null packet
+        }
+        hdmi_packet_seal_fast(&p);
+        hdmi_island_encode_fast(island, &p, sync);
+    }
+    uint32_t *t = island + HDMI_ISLAND_WORDS;
+    t[0] = CMD_RAW_REPEAT | (H_SYNC - 8 - HDMI_ISLAND_WORDS);
+    t[1] = SYNC_WORD(hdmi_ctrl[sync]);
+    if (hdmi_line_active(line)) {
+        t[2] = CMD_RAW_REPEAT | (H_BACK - 10);
+        t[3] = SYNC_WORD(hdmi_ctrl[idle]);
+        t[4] = CMD_RAW_REPEAT | 8;
+        t[5] = HDMI_VIDEO_PREAMBLE(idle);
+        t[6] = CMD_RAW | 2;
+        t[7] = HDMI_VIDEO_GUARD;
+        t[8] = HDMI_VIDEO_GUARD;
+        t[9] = CMD_TMDS | H_ACTIVE;
+    } else {
+        t[2] = CMD_RAW_REPEAT | (H_BACK + H_ACTIVE);
+        t[3] = SYNC_WORD(hdmi_ctrl[idle]);
+    }
+}
+
+static void hdmi_init(void)
+{
+    hdmi_bch_table_init();
+    hdmi_packet_t p;
+    hdmi_packet_avi(&p);
+    hdmi_island_encode(hdmiIslandAvi, &p, HDMI_HV);
+    hdmi_packet_audio_info(&p);
+    hdmi_island_encode(hdmiIslandAudioInfo, &p, HDMI_HV);
+    hdmi_packet_acr(&p, 6144, 25200); // 25.2 MHz * 6144 / (128 * 25200) = 48 kHz
+    hdmi_island_encode(hdmiIslandAcr, &p, HDMI_HV);
+    for (unsigned line = 0; line < HDMI_SLOTS; line++)
+        hdmi_fill(line);
+    hdmiNextLine = HDMI_SLOTS;
+}
+
+// A DMA channel's alias 3 registers; writing read_addr starts the transfer.
+typedef struct {
+    uint32_t ctrl, write_addr, count, read_addr;
+} dvi_block_t;
+
+static dvi_block_t dviBlocks[DVI_BLOCKS];
+static const dvi_block_t *dviListStart = dviBlocks;
+static uint32_t dviLineBuf[DVI_LINE_BUFS][H_ACTIVE / 4];
+static uint32_t dviExpand[256][4]; // one frame byte -> 16 doubled RGB332 pixels
+static uint dviControl, dviData;
+
+// In FAST mode, and while it loads or saves, the ZX81 makes no picture and a TV shows
+// none. So after six output frames (100 ms) with no new ZX81 frame, the output goes
+// black. Shorter gaps hold the last frame: the ROM stops the display for a moment when
+// a line is entered in SLOW mode, which a TV shows as a jump rather than a blank, and
+// one missed frame in about 750 is the normal drift between 59.92 and 60 Hz.
+#define DVI_MISSED_TO_BLANK 6
+static const uint8_t dviBlackRow[DVI_FB_STRIDE] = {0}; // all 0: black
+static unsigned dviMissed = DVI_MISSED_TO_BLANK;
+
+static void __not_in_flash_func(dvi_render)(unsigned fbY)
+{
+    uint32_t *out = dviLineBuf[fbY % DVI_LINE_BUFS];
+    const uint8_t *in = dviMissed >= DVI_MISSED_TO_BLANK ? dviBlackRow : dviFb[dviShow][fbY];
+    for (unsigned i = 0; i < DVI_FB_STRIDE; i++, out += 4) {
+        const uint32_t *e = dviExpand[in[i]];
+        out[0] = e[0]; out[1] = e[1]; out[2] = e[2]; out[3] = e[3];
+    }
+}
+
+static void __not_in_flash_func(dvi_new_frame)(void)
+{
+    if (dviReady != 0xFF) {
+        dviShow = dviReady;
+        dviReady = 0xFF;
+        dviMissed = 0;
+    } else if (dviMissed < DVI_MISSED_TO_BLANK) {
+        dviMissed++;
+    }
+    dvi_render(0);
+    dvi_render(1);
+}
+
+// Raised by each line's slot block as it finishes loading the FIFO. The control
+// channel has then loaded the next block, or is loading it: for a blank line X (block
+// X) it points at block X + 1 or X + 2, for picture line y (slot block blank + 2y) at
+// blank + 2y + 1 or + 2. Picture lines come out exact; a blank line may read one late.
+static bool dviFrameDone;
+
+static void __not_in_flash_func(dvi_line_irq)(void)
+{
+    if (!(dma_hw->ints1 & (1u << dviData)))
+        return;
+    dma_hw->ints1 = 1u << dviData;
+    const unsigned blank = V_TOTAL - V_ACTIVE;
+    unsigned next = ((uint32_t)dma_hw->ch[dviControl].read_addr - (uint32_t)dviBlocks) /
+                    sizeof(dvi_block_t);
+    unsigned line = next > blank && next < DVI_BLOCKS - 1 ? blank + (next - blank - 1) / 2
+                  : next >= 1 && next <= blank ? next - 1 : 0;
+
+    // HDMI islands. Behind (DMA has passed the next line to fill): skip ahead.
+    if ((hdmiNextLine + V_TOTAL - line) % V_TOTAL > V_TOTAL / 2)
+        hdmiNextLine = (line + 1) % V_TOTAL;
+    while ((hdmiNextLine + V_TOTAL - line) % V_TOTAL <= HDMI_AHEAD - 1) {
+        hdmi_fill(hdmiNextLine);
+        hdmiNextLine = (hdmiNextLine + 1) % V_TOTAL;
+    }
+
+    if (line < blank) {
+        // The vertical blank, 1.4 ms: catch up on the ring a share at a time (one long
+        // drain would hold up the island fills), then show the newest frame in time
+        // for the first picture line.
+        dvi_drain(64);
+        if (line >= blank - 6 && !dviFrameDone) {
+            dviFrameDone = true;
+            dvi_new_frame();
+        }
+        return;
+    }
+    dviFrameDone = false;
+    // This interrupt comes as picture line y starts, about when the old row interrupt
+    // came for line y - 1, so render as that did: two frame lines ahead of the output.
+    unsigned y = line - blank;
+    if (y >= 1 && ((y - 1) & 1)) {
+        unsigned fbY = y / 2 + 1;
+        if (fbY < DVI_FB_H)
+            dvi_render(fbY);
+    }
+    dvi_drain(64);
+}
+
+// Call right after set_sys_clock_khz(208 MHz), before any peripheral is set up.
+void dvi_clocks_init(void)
+{
+    uint32_t sys = clock_get_hz(clk_sys);
+    clock_configure(clk_peri, 0, CLOCKS_CLK_PERI_CTRL_AUXSRC_VALUE_CLK_SYS, sys, sys);
+    clock_stop(clk_usb);
+    clock_stop(clk_adc);
+    clock_stop(clk_hstx);
+    pll_init(pll_usb, 1, 1008 * MHZ, 4, 2); // 126 MHz
+    clock_configure(clk_hstx, 0, CLOCKS_CLK_HSTX_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB,
+                    126 * MHZ, 126 * MHZ);
+}
+
+static void dvi_hstx_init(void)
+{
+    reset_block_num(RESET_HSTX);
+    unreset_block_num_wait_blocking(RESET_HSTX);
+    // RGB332: blue on lane 0, green on 1, red on 2
+    hstx_ctrl_hw->expand_tmds =
+        2u << HSTX_CTRL_EXPAND_TMDS_L2_NBITS_LSB | 0u << HSTX_CTRL_EXPAND_TMDS_L2_ROT_LSB |
+        2u << HSTX_CTRL_EXPAND_TMDS_L1_NBITS_LSB | 29u << HSTX_CTRL_EXPAND_TMDS_L1_ROT_LSB |
+        1u << HSTX_CTRL_EXPAND_TMDS_L0_NBITS_LSB | 26u << HSTX_CTRL_EXPAND_TMDS_L0_ROT_LSB;
+    hstx_ctrl_hw->expand_shift =
+        4u << HSTX_CTRL_EXPAND_SHIFT_ENC_N_SHIFTS_LSB |
+        8u << HSTX_CTRL_EXPAND_SHIFT_ENC_SHIFT_LSB |
+        1u << HSTX_CTRL_EXPAND_SHIFT_RAW_N_SHIFTS_LSB |
+        0u << HSTX_CTRL_EXPAND_SHIFT_RAW_SHIFT_LSB;
+    hstx_ctrl_hw->csr = 0;
+    hstx_ctrl_hw->csr = HSTX_CTRL_CSR_EXPAND_EN_BITS | 5u << HSTX_CTRL_CSR_CLKDIV_LSB |
+                        5u << HSTX_CTRL_CSR_N_SHIFTS_LSB | 2u << HSTX_CTRL_CSR_SHIFT_LSB |
+                        HSTX_CTRL_CSR_EN_BITS;
+    // As routed on the card: CK, D0, D1, D2 from HSTX bit 0, negative on even bits.
+    for (unsigned bit = 0; bit < 8; bit++) {
+        int lane = (int)(bit / 2) - 1;
+        uint32_t config = lane < 0 ? HSTX_CTRL_BIT0_CLK_BITS
+                                   : (uint32_t)(lane * 10) << HSTX_CTRL_BIT0_SEL_P_LSB |
+                                     (uint32_t)(lane * 10 + 1) << HSTX_CTRL_BIT0_SEL_N_LSB;
+        if (!(bit & 1))
+            config |= HSTX_CTRL_BIT0_INV_BITS;
+        hstx_ctrl_hw->bit[bit] = config;
+    }
+}
+
+static void dvi_dma_init(void)
+{
+    dviControl = dma_claim_unused_channel(true);
+    dviData = dma_claim_unused_channel(true);
+
+    dma_channel_config d = dma_channel_get_default_config(dviData);
+    channel_config_set_dreq(&d, DREQ_HSTX);
+    channel_config_set_chain_to(&d, dviControl);
+    channel_config_set_high_priority(&d, true);
+    channel_config_set_irq_quiet(&d, true);
+    dma_channel_config slots = d;
+    channel_config_set_irq_quiet(&slots, false);
+    dma_channel_config restart = dma_channel_get_default_config(dviData); // no chain
+    channel_config_set_read_increment(&restart, false);
+    channel_config_set_high_priority(&restart, true);
+    channel_config_set_irq_quiet(&restart, true);
+
+    uint32_t rowCtrl = channel_config_get_ctrl_value(&d);
+    uint32_t slotCtrl = channel_config_get_ctrl_value(&slots);
+    uint32_t fifo = (uint32_t)&hstx_fifo_hw->fifo;
+    unsigned n = 0;
+    for (unsigned line = 0; line < V_TOTAL; line++) {
+        dviBlocks[n++] = (dvi_block_t){slotCtrl, fifo, hdmi_slot_words(line),
+                                       (uint32_t)hdmiSlots[line % HDMI_SLOTS]};
+        if (hdmi_line_active(line)) {
+            unsigned y = line - (V_TOTAL - V_ACTIVE);
+            dviBlocks[n++] = (dvi_block_t){rowCtrl, fifo, H_ACTIVE / 4,
+                                           (uint32_t)dviLineBuf[(y / 2) % DVI_LINE_BUFS]};
+        }
+    }
+    dviBlocks[n++] = (dvi_block_t){channel_config_get_ctrl_value(&restart),
+                                   (uint32_t)&dma_hw->ch[dviControl].al3_read_addr_trig, 1,
+                                   (uint32_t)&dviListStart};
+
+    dma_channel_set_irq1_enabled(dviData, true);
+    irq_add_shared_handler(DMA_IRQ_1, dvi_line_irq, PICO_SHARED_IRQ_HANDLER_HIGHEST_ORDER_PRIORITY);
+    irq_set_priority(DMA_IRQ_1, 0);
+    irq_set_enabled(DMA_IRQ_1, true);
+
+    dma_channel_config c = dma_channel_get_default_config(dviControl);
+    channel_config_set_write_increment(&c, true);
+    channel_config_set_ring(&c, true, 4); // the four alias 3 registers
+    channel_config_set_high_priority(&c, true);
+    bus_ctrl_hw->priority = BUSCTRL_BUS_PRIORITY_DMA_R_BITS | BUSCTRL_BUS_PRIORITY_DMA_W_BITS;
+    dma_channel_configure(dviControl, &c, &dma_hw->ch[dviData].al3_ctrl, dviBlocks, 4, true);
+}
+
+// After dvi_clocks_init() and pio_video_code_init() (for borderInverter).
+void dvi_init(void)
+{
+    for (unsigned b = 0; b < 256; b++) {
+        uint8_t *out = (uint8_t *)dviExpand[b];
+        for (unsigned i = 0; i < 8; i++)
+            out[2 * i] = out[2 * i + 1] = (b & (0x80 >> i)) ? 0xFF : 0x00;
+    }
+    for (uint8_t i = 0; i < DVI_FB_COUNT; i++)
+        dvi_fb_clear(i);
+    dvi_new_frame();
+    hdmi_init();
+    dvi_hstx_init();
+    dvi_dma_init();
+    for (unsigned pin = HSTX_PIN_0; pin <= HSTX_PIN_7; pin++)
+        gpio_set_function(pin, GPIO_FUNC_HSTX);
+}
+
+#endif // _DVI_IMPL_H_
